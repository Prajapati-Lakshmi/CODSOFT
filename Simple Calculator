#include<iostream>
using namespace std;
int main()
{
	double num1,num2,result;
	char op;
	int next;
	operation:
	cout<<"Enter first number:";
	cin>>num1;
	cout<<"Enter second number:";
	cin>>num2;
	bool validOperator=false;
	while(!validOperator)
	{
	cout<<"Enter operator (+  -  *  / )\n";
	cin>>op;
	switch(op)
	{
		case'+':
		result=num1+num2;
		validOperator=true;
		break;	
		case'-':
		result=num1-num2;
		validOperator=true;
		break;	
		case'*':
		result=num1*num2;
		validOperator=true;
		break;	
		case'/':
		result=num1/num2;
		validOperator=true;
		break;		
        default:
        cout<<"Choose the correct operator\n ";
		validOperator=false;	
	}
}
	cout<<"The required answer is : "<<result<<endl;
	cout<<"Enter 1 for another operation\n";
	cin>>next;
	if(next==1)  {
		cout<<" ---------Perform another operation------------\n";
	  goto operation;
}
	return 0;
}
